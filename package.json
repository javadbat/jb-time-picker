      "types": "./react/dist/JBTimePicker.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "customElements": "web-component/custom-elements.json",
  "repository": {
    "type": "git",
    "url": "git@github.com:javadbat/jb-time-picker.git"
  },
